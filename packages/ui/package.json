{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./backend/*": "./src/backend/*/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./controls.css": "./src/controls.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open --ci",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --config .storybook/vitest.config.ts --project light",
    "test:storybook:themes": "vitest run --config .storybook/vitest.config.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test:foundations": "node --test scripts/*.test.mjs",
    "typecheck:storybook": "tsc --project .storybook/tsconfig.json",
    "verify:storybook": "node scripts/verify-storybook.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/runner": "4.1.11",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "vite": "8.3.4"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
