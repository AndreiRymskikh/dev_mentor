# Local development only. Copy to .env and choose a password before starting.
POSTGRES_DB=devmentor
POSTGRES_USER=devmentor
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Connection URL for the host-run app/ORM. Replace the placeholder with your
# URL-encoded password, and keep the database/user/port consistent with above.
DATABASE_URL=postgresql://devmentor:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/devmentor

# Registration is fail-closed until these server-side settings are configured.
# Generate RATE_LIMIT_SECRET with at least 32 random bytes; never commit it.
RATE_LIMIT_SECRET=
APP_ORIGIN=http://localhost:3000
EMAIL_FROM=devmentor@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Explicit local loopback mail-sink policy, permitted only NODE_ENV=development/test.
# Production: false, HTTPS APP_ORIGIN, TLS-capable SMTP and both credentials required.
SMTP_LOCAL_SINK=true
SMTP_USER=
SMTP_PASSWORD=
