{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @devmentor/app",
    "start": "npm run start --workspace @devmentor/app",
    "build": "npm run build --workspace @devmentor/app",
    "lint": "eslint packages scripts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node scripts/smoke-app.mjs"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
