{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @devmentor/app --",
    "start": "npm run start --workspace @devmentor/app --",
    "build": "npm run build --workspace @devmentor/app",
    "lint": "eslint packages scripts tests",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "smoke": "node scripts/smoke-app.mjs",
    "auth:maintain": "tsx --tsconfig tsconfig.base.json scripts/maintain-auth.mts",
    "auth:bootstrap-admin": "tsx --tsconfig tsconfig.base.json scripts/bootstrap-admin.mts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps postgres",
    "db:psql": "docker compose exec postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:check": "docker compose exec -T postgres sh -c 'PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -v ON_ERROR_STOP=1 -c \"SELECT current_database(), version();\"'",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm audit && npm run build",
    "db:migration:create": "npm run migration:create --workspace @devmentor/db --",
    "db:migrate": "npm run migration:up --workspace @devmentor/db --",
    "db:migrate:down": "npm run migration:down --workspace @devmentor/db --",
    "db:schema:update": "npm run schema:update --workspace @devmentor/db --",
    "db:seed": "npm run seed --workspace @devmentor/db --",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "tsx --tsconfig tsconfig.base.json tests/integration/run.mts",
    "browser:install": "agent-browser install",
    "setup": "node scripts/setup.mjs",
    "test:setup": "tsx --tsconfig tsconfig.base.json tests/integration/setup.mts",
    "storybook": "npm run storybook --workspace @devmentor/ui",
    "build-storybook": "npm run build-storybook --workspace @devmentor/ui",
    "test:storybook": "npm run test:storybook --workspace @devmentor/ui",
    "test:storybook:themes": "npm run test:storybook:themes --workspace @devmentor/ui",
    "check:tokens": "npm run check:tokens --workspace @devmentor/ui",
    "test:foundations": "npm run test:foundations --workspace @devmentor/ui",
    "typecheck:storybook": "npm run typecheck:storybook --workspace @devmentor/ui",
    "verify:storybook": "npm run verify:storybook --workspace @devmentor/ui"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "3.5.13",
    "@vitest/coverage-v8": "5.0.5",
    "agent-browser": "^0.39.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "smtp-server": "3.20.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
